# URL de l'API backend joignable depuis le SERVEUR Nuxt (SSR).
# - En local (hors Docker) : http://localhost:5000/api
# - En Docker Compose      : http://api:5000/api (nom du service backend)
NUXT_API_BASE=http://localhost:5000/api

# URL de l'API backend joignable depuis le NAVIGATEUR de l'utilisateur.
# Doit toujours rester une URL publique/hôte, jamais un nom de service Docker.
NUXT_PUBLIC_API_BASE=http://localhost:5000/api
